{
    "name": "frootbox/core",
    "description": "Core of the Frootbox CMS",
    "type": "library",
    "license": "LGPL-3.0-only",
    "keywords": ["cms", "frootbox"],
    "require": {
        "php": ">=8.5",
        "nikic/fast-route": "^1.3",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.1",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "symfony/dotenv": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Frootbox\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Frootbox\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
