{
    "name": "frootbox/core",
    "description": "Core of the Frootbox CMS",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cms",
        "frootbox"
    ],
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/migrations": "^3.9",
        "firebase/php-jwt": "^7.2",
        "frootbox/database": "^0.1",
        "frootbox/rich-text": "^0.1",
        "intervention/image": "^4.4",
        "monolog/monolog": "^3.9",
        "nikic/fast-route": "^1.3",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "opis/json-schema": "^2.6",
        "php-di/php-di": "^7.1",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/polyfill-intl-normalizer": "^1.33",
        "symfony/yaml": "^8.1",
        "twig/twig": "^3.30"
    },
    "autoload": {
        "psr-4": {
            "Frootbox\\Core\\": "src/",
            "Frootbox\\Core\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Frootbox\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
